# ─────────────────────────────────────────────────────────────
# OceanAI Website — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── Anthropic API (REQUIRED for Playground AI features) ──────
# Get your key at: https://console.anthropic.com
# Used by: /app/api/claude/route.ts
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Site URL (used for OG images, sitemap, canonical URLs) ───
NEXT_PUBLIC_SITE_URL=https://oceanai-website-kappa.vercel.app

# ── Analytics (optional — Vercel Analytics is zero-config) ───
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxxx
# NEXT_PUBLIC_GA_ID=G-xxxx

# ─────────────────────────────────────────────────────────────
# Vercel deployment notes:
# 1. Add ANTHROPIC_API_KEY in Vercel → Project → Settings → Environment Variables
# 2. Set for: Production, Preview, Development
# 3. The /api/claude route is edge-compatible — it uses fetch() not the SDK
# ─────────────────────────────────────────────────────────────
